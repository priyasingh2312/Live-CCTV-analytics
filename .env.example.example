# Copy this file to ".env" and fill in your values. Never commit .env.

# Camera (overrides camera.source in config.yaml)
#RTSP_URL=rtsp://username:password@192.168.1.64:554/Streaming/Channels/101

# Dashboard login (streamlit run dashboard\app.py). Leave the password empty only while testing.
DASHBOARD_USER=client
DASHBOARD_PASSWORD=

# Telegram alerts (set alerts.telegram.enabled: true in config.yaml)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (set alerts.email.enabled: true in config.yaml)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
